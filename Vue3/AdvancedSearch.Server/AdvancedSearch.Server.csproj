<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\AdvancedSearch.Client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdvancedSearch.Client\AdvancedSearch.Client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Transitive pin: EF Core 10.0.x resolves Microsoft.Data.SqlClient 6.1.7, whose
         System.Security.Cryptography.Pkcs 9.0.11 is vulnerable (NU1902/NU1903). Can be dropped once
         EF Core depends on Microsoft.Data.SqlClient 6.1.8 or later. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Korzh.DbUtils.Import" />
    <PackageReference Include="Korzh.DbUtils.SqlServer" />
    <PackageReference Include="Korzh.DbUtils.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EasyData.Exporters.ClosedXML" />
    <PackageReference Include="EasyData.Exporters.PdfSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Korzh.EasyQuery.AspNetCore" />
    <PackageReference Include="Korzh.EasyQuery.EntityFrameworkCore.Relational" />
    <PackageReference Include="Korzh.EasyQuery.SqlServerGate" />
    <PackageReference Include="Korzh.EasyQuery.SqLiteGate" />
    <PackageReference Include="Korzh.EasyQuery.DataExport" />
  </ItemGroup>
</Project>